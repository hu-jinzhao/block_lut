From: LUT-MoE Team
Date: 2026-07-18
Subject: [PATCH] Integrate BlockLUT decompression + ExpertCacheManager into ggml_cuda_mul_mat_id

This patch modifies ggml_cuda_mul_mat_id to:
1. Block fast-paths for BLOCKLUT types
2. Intercept the expert-weight loop to call ExpertCacheManager
3. Use decompressed bf16 weights for the actual matmul

---
 ggml/src/ggml-cuda/ggml-cuda.cu | 107 +++++++++++++++++++++++++++++---
 1 file changed, 98 insertions(+), 9 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index abcdef1..1234567 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -55,6 +55,9 @@
 #include "ggml-cuda/set-rows.cuh"
 #include "ggml-cuda/pad_reflect_1d.cuh"
 #include "ggml-cuda/solve_tri.cuh"
+#include "ggml-cuda/blocklut.cuh"          // BlockLUT dequantize kernels
+
+#include "llama-io.h"                      // ExpertCacheManager

 #include "ggml.h"

@@ -1731,6 +1734,42 @@ static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tenso
 static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     const ggml_tensor * src0 = dst->src[0];
     const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * ids  = dst->src[2];
+
+    // ──────────────────────────────────────────────────────────────────────
+    // LUT-MoE: BlockLUT expert cache path
+    // When src0 is a BLOCKLUT type, we need to decompress experts on-the-fly
+    // using the ExpertCacheManager before doing the matmul.
+    // ──────────────────────────────────────────────────────────────────────
+    const bool is_blocklut = (src0->type == GGML_TYPE_BLOCKLUT8 ||
+                              src0->type == GGML_TYPE_BLOCKLUT6 ||
+                              src0->type == GGML_TYPE_BLOCKLUT4);
+
+    if (is_blocklut && g_expert_cache.is_initialized()) {
+        GGML_ASSERT(src1->type == GGML_TYPE_F32);
+        GGML_ASSERT(dst->type  == GGML_TYPE_F32);
+
+        GGML_TENSOR_BINARY_OP_LOCALS
+        cudaStream_t stream = ctx.stream();
+
+        const int64_t n_expert_used = ids->ne[0];
+        const int64_t ne_get_rows = ne12 * n_expert_used;
+
+        // Step 1: Copy expert IDs from GPU to host to determine which experts are needed
+        std::vector<int32_t> ids_host(ggml_nbytes(ids) / sizeof(int32_t));
+        CUDA_CHECK(cudaMemcpyAsync(ids_host.data(), ids->data, ggml_nbytes(ids),
+                                   cudaMemcpyDeviceToHost, stream));
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+
+        // Step 2: Collect unique needed experts
+        std::vector<int> needed_experts;
+        std::vector<bool> seen(ne02, false);
+        for (int64_t i12 = 0; i12 < ne12; ++i12) {
+            for (int64_t iex = 0; iex < n_expert_used; ++iex) {
+                int32_t expert_id = ids_host[i12 * n_expert_used + iex];
+                if (expert_id >= 0 && expert_id < ne02 && !seen[expert_id]) {
+                    seen[expert_id] = true;
+                    needed_experts.push_back(expert_id);
+                }
+            }
+        }
+
+        // Step 3: Inject layer_id into tensor op_params (set during graph building)
+        // Default to 0 if not set
+        int layer_id = 0;
+        if (dst->op_params[0] != 0) {
+            layer_id = dst->op_params[0];
+        }
+
+        // Step 4: Pre-fetch all needed experts (non-blocking SSD reads + async decompress)
+        g_expert_cache.batch_prefetch(layer_id, needed_experts, stream);
+
+        // Step 5: Build sorted expert token counts (same as original code)
+        std::vector<int32_t> tokens_per_expert(ne02, 0);
+        for (int64_t i02 = 0; i02 < ne02; ++i02) {
+            for (int64_t i12 = 0; i12 < ne12; ++i12) {
+                for (int64_t iex = 0; iex < n_expert_used; ++iex) {
+                    if (ids_host[i12 * n_expert_used + iex] == i02) {
+                        tokens_per_expert[i02]++;
+                        break;
+                    }
+                }
+            }
+        }
+
+        // Step 6: Set up sorted src1 and dst buffers (same as original)
+        const int64_t ne_get_rows_ex = ne12 * n_expert_used;
+        std::vector<int32_t> ids_to_sorted_host, ids_from_sorted_host(ne_get_rows_ex);
+        ids_to_sorted_host.reserve(2 * ne_get_rows_ex);
+
+        for (int64_t i02 = 0; i02 < ne02; ++i02) {
+            for (int64_t i12 = 0; i12 < ne12; ++i12) {
+                for (int64_t iex = 0; iex < n_expert_used; ++iex) {
+                    if (ids_host[i12 * n_expert_used + iex] == i02) {
+                        ids_from_sorted_host[i12 * n_expert_used + iex] = ids_to_sorted_host.size();
+                        ids_to_sorted_host.push_back(i12 * ne11 + iex % ne11);
+                        break;
+                    }
+                }
+            }
+        }
+
+        ggml_cuda_pool_alloc<int32_t> ids_buf_dev(ctx.pool(), 2 * ne_get_rows_ex);
+        ids_to_sorted_host.insert(ids_to_sorted_host.end(),
+                                  ids_from_sorted_host.begin(),
+                                  ids_from_sorted_host.end());
+        CUDA_CHECK(cudaMemcpyAsync(ids_buf_dev.ptr, ids_to_sorted_host.data(),
+                                   2 * ne_get_rows_ex * sizeof(int32_t),
+                                   cudaMemcpyHostToDevice, stream));
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+
+        const int32_t * ids_to_sorted   = ids_buf_dev.ptr + 0 * ne_get_rows_ex;
+        const int32_t * ids_from_sorted = ids_buf_dev.ptr + 1 * ne_get_rows_ex;
+
+        const ggml_type type_src1_sorted = GGML_TYPE_F32;
+        const ggml_type type_dst_sorted  = GGML_TYPE_F32;
+        const size_t ts_src1_sorted = ggml_type_size(type_src1_sorted);
+        const size_t ts_dst_sorted  = ggml_type_size(type_dst_sorted);
+
+        ggml_cuda_pool_alloc<char> src1_sorted(ctx.pool(),
+            ne12 * n_expert_used * ne10 * ts_src1_sorted);
+        ggml_cuda_pool_alloc<char> dst_sorted(ctx.pool(),
+            ne2 * n_expert_used * ne0 * ts_dst_sorted);
+
+        // Gather src1 sorted by expert
+        get_rows_cuda(src1->data, src1->type, ids_to_sorted,
+            src1_sorted.ptr, type_src1_sorted,
+            ne10, nb11, nb12, nb13,
+            ne_get_rows_ex, 1, 1, sizeof(int32_t),
+            ne_get_rows_ex * sizeof(int32_t),
+            ne_get_rows_ex * sizeof(int32_t),
+            ne10 * ts_src1_sorted,
+            ne_get_rows_ex * ne10 * ts_src1_sorted,
+            ne_get_rows_ex * ne10 * ts_src1_sorted,
+            stream);
+        CUDA_CHECK(cudaGetLastError());
+
+        // Step 7: Process each expert with cached/decompressed weights
+        char * src1_data_cur = (char *)src1_sorted.ptr;
+        char * dst_data_cur  = (char *)dst_sorted.ptr;
+
+        for (int64_t i02 = 0; i02 < ne02; ++i02) {
+            if (tokens_per_expert[i02] == 0) continue;
+
+            // Get decompressed bf16 weights from cache
+            uint16_t * expert_gpu = g_expert_cache.get_expert_weights(
+                layer_id, (int)i02, stream);
+
+            if (!expert_gpu) {
+                // Fallback: use original compressed data (may produce garbage)
+                fprintf(stderr, "[LUT-MoE] WARNING: expert %d/%d not in cache, using raw data\n",
+                        layer_id, (int)i02);
+                expert_gpu = (uint16_t *)((char *)src0->data + i02 * nb02);
+            }
+
+            // Create tensor slice pointing to decompressed bf16 data
+            ggml_tensor src0_slice = *src0;
+            src0_slice.type       = GGML_TYPE_BF16;
+            src0_slice.ne[2]      = 1;
+            src0_slice.nb[3]      = src0_slice.nb[2];
+            src0_slice.op         = GGML_OP_VIEW;
+            src0_slice.view_src   = dst->src[0];
+            src0_slice.data       = (char *)expert_gpu;
+
+            ggml_tensor src1_slice;
+            memset(&src1_slice, 0, sizeof(src1_slice));
+            src1_slice.buffer = src1->buffer;
+            src1_slice.type   = type_src1_sorted;
+            src1_slice.ne[0]  = ne10;
+            src1_slice.ne[1]  = tokens_per_expert[i02];
+            src1_slice.ne[2]  = 1;
+            src1_slice.ne[3]  = 1;
+            src1_slice.nb[0]  = ts_src1_sorted;
+            src1_slice.nb[1]  = src1_slice.ne[0] * src1_slice.nb[0];
+            src1_slice.nb[2]  = src1_slice.ne[1] * src1_slice.nb[1];
+            src1_slice.nb[3]  = src1_slice.ne[2] * src1_slice.nb[2];
+            src1_slice.data   = src1_data_cur;
+
+            ggml_tensor dst_slice;
+            memset(&dst_slice, 0, sizeof(dst_slice));
+            dst_slice.buffer = dst->buffer;
+            dst_slice.type   = type_dst_sorted;
+            dst_slice.ne[0]  = ne0;
+            dst_slice.ne[1]  = tokens_per_expert[i02];
+            dst_slice.ne[2]  = 1;
+            dst_slice.ne[3]  = 1;
+            dst_slice.nb[0]  = ts_dst_sorted;
+            dst_slice.nb[1]  = dst_slice.ne[0] * dst_slice.nb[0];
+            dst_slice.nb[2]  = dst_slice.ne[1] * dst_slice.nb[1];
+            dst_slice.nb[3]  = dst_slice.ne[2] * dst_slice.nb[2];
+            dst_slice.data   = dst_data_cur;
+
+            // Standard bf16 matmul (handled by cuBLAS)
+            ggml_cuda_mul_mat(ctx, &src0_slice, &src1_slice, &dst_slice);
+            CUDA_CHECK(cudaGetLastError());
+
+            src1_data_cur += src1_slice.nb[2];
+            dst_data_cur  += dst_slice.nb[2];
+        }
+
+        // Step 8: Scatter results back to original order
+        get_rows_cuda(dst_sorted.ptr, type_dst_sorted, ids_from_sorted,
+            dst->data, dst->type,
+            ne0, ne0 * ts_dst_sorted,
+            ne_get_rows_ex * ne0 * ts_dst_sorted,
+            ne_get_rows_ex * ne0 * ts_dst_sorted,
+            ne_get_rows_ex, 1, 1, sizeof(int32_t),
+            ne_get_rows_ex * sizeof(int32_t),
+            ne_get_rows_ex * sizeof(int32_t),
+            nb1, nb2, nb3, stream);
+
+        return;  // Skip the original code path
+    }
+
+    // ──────────────────────────────────────────────────────────────────────
+    // Original code continues below for non-BLOCKLUT types
+    // ──────────────────────────────────────────────────────────────────────

     GGML_ASSERT(src1->type == GGML_TYPE_F32);
     GGML_ASSERT(dst->type  == GGML_TYPE_F32);

     const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;

+    // [LUT-MoE] Skip fast paths for BLOCKLUT types
+    if (!is_blocklut) {
     // [TAG_MUL_MAT_ID_CUDA_GRAPHS]
     if (src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32) {
         static_assert(MMVQ_MAX_BATCH_SIZE == MMVF_MAX_BATCH_SIZE);
@@ -1768,6 +1865,7 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
             return;
         }
     }
+    } // !is_blocklut

     // note: this path should not be reached when recording CUDA graphs, because it requires stream synchronization
     // TODO: add asserts to verify this. should work with CUDA, HIP, etc.
